# Virtual environment
.venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Audio output files
*.wav
*.mp3
*.m4a

# Temporary files
*.tmp
temp_*

# OS files
.DS_Store
Thumbs.db

# Environment and secrets: .env, and a filled runner.env or agent.env wherever it is,
