# The narration pipeline's containers, in the rootless service account's systemd user
# manager (docs/pipeline.md, "Deploy, rootless Podman"). Linked into
# ~/.config/systemd/user/ and enabled there; with linger on, it starts at boot.
#
# A plain `up -d`: which services it starts is COMPOSE_PROFILES in deploy/.env. Empty,
# that's narration-agent alone; `schedule` adds narration-runner after the acceptance run.
# Stopping the unit stops the containers and keeps them and their volumes (never `down`).

[Unit]
Description=Narration pipeline containers (rootless Podman; docs/pipeline.md)
Requires=podman.socket
# After podman.service as well: at shutdown this unit's `stop` runs before the podman API it
# talks to goes away.
After=podman.socket podman.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DOCKER_HOST=unix://%t/podman/podman.sock
WorkingDirectory=%h/kokoro-reader
ExecStart=%h/.local/bin/docker-compose -f deploy/compose.yaml up -d
ExecStop=%h/.local/bin/docker-compose -f deploy/compose.yaml stop

[Install]
WantedBy=default.target
