# The egress limit for one rootless service account: svc-egress@ACCOUNT.service runs
# /usr/local/sbin/svc-egress apply ACCOUNT (docs/pipeline.md, "Deploy, rootless Podman").
# Installed by root from a pinned commit, with svc-egress, never from the account's home.
# The account's user manager Requires= this unit (user-egress.conf), so its containers
# start only after the table is in, and stop if this unit stops.

[Unit]
Description=Egress limit for the %i service account (svc-egress; docs/pipeline.md)
After=network-pre.target ufw.service netfilter-persistent.service firewalld.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/svc-egress apply %i
# Stopped, the account is denied outright, not left unlimited. Lifting it is `svc-egress remove`.
ExecStop=/usr/local/sbin/svc-egress deny %i
# A changed grant: `systemctl reload`, which re-applies in place. Not `restart`: the account's
# user manager Requires= this unit, so a restart restarts it too, and every container.
ExecReload=/usr/local/sbin/svc-egress apply %i

[Install]
WantedBy=multi-user.target
